<svg width="200" height="24" viewBox="0 0 200 24" xmlns="http://www.w3.org/2000/svg">
  <!-- Repeatable tile: use as a CSS background-image, background-repeat: repeat-x -->
  <defs>
    <pattern id="mosaicTile" width="40" height="24" patternUnits="userSpaceOnUse">
      <rect width="40" height="24" fill="#0b1f16"/>
      <!-- diamond motif -->
      <polygon points="20,2 34,12 20,22 6,12" fill="#ffffff"/>
      <polygon points="20,6 28,12 20,18 12,12" fill="#008C45"/>
      <circle cx="20" cy="12" r="2.4" fill="#CD212A"/>
      <!-- corner accents -->
      <polygon points="0,0 6,0 0,6" fill="#CD212A" opacity="0.85"/>
      <polygon points="40,0 34,0 40,6" fill="#008C45" opacity="0.85"/>
      <polygon points="0,24 6,24 0,18" fill="#008C45" opacity="0.85"/>
      <polygon points="40,24 34,24 40,18" fill="#CD212A" opacity="0.85"/>
    </pattern>
  </defs>
  <rect width="200" height="24" fill="url(#mosaicTile)"/>
</svg>
